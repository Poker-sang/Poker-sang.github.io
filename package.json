{
  "name": "poker-sang-blog",
  "version": "0.0.1",
  "type": "module",
  "description": "扑克博客站",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501",
  "scripts": {
    "build": "vuepress-vite build docs",
    "clean-dev": "vuepress-vite dev docs --clean-cache",
    "dev": "vuepress-vite dev docs",
    "format": "prettier --write .",
    "prepare": "husky",
    "update-package": "pnpm dlx vp-update@next"
  },
  "devDependencies": {
    "@mathjax/src": "^4.0.0",
    "@vuepress/bundler-vite": "2.0.0-rc.26",
    "@vuepress/plugin-blog": "2.0.0-rc.121",
    "@vuepress/plugin-comment": "2.0.0-rc.121",
    "@vuepress/plugin-feed": "2.0.0-rc.121",
    "htmlparser2": "^10.0.0",
    "husky": "^9.1.7",
    "mermaid": "^11.12.2",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-pkg": "^0.21.2",
    "sass-embedded": "^1.96.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.25",
    "vuepress": "2.0.0-rc.26",
    "vuepress-theme-hope": "2.0.0-rc.99"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "avoid",
    "endOfLine": "auto",
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-pkg"
    ]
  }
}
