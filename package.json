{
  "name": "poker-sang-blog",
  "version": "0.0.1",
  "type": "module",
  "description": "扑克博客站",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "build": "vuepress-vite build docs",
    "clean-dev": "vuepress-vite dev docs --clean-cache",
    "dev": "vuepress-vite dev docs",
    "format": "prettier --write .",
    "prepare": "husky",
    "update-package": "pnpm dlx vp-update@next"
  },
  "devDependencies": {
    "@mathjax/src": "^4.1.3",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-blog": "2.0.0-rc.130",
    "@vuepress/plugin-comment": "2.0.0-rc.130",
    "@vuepress/plugin-feed": "2.0.0-rc.130",
    "htmlparser2": "^12.0.0",
    "husky": "^9.1.7",
    "mermaid": "^11.16.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-pkg": "^0.22.1",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.41",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "avoid",
    "endOfLine": "auto",
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-pkg"
    ]
  }
}
